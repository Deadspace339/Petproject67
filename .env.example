# Скопируйте в .env и подставьте свои значения.
# Файл сохраняйте в UTF-8 БЕЗ BOM, иначе первая переменная не прочитается.

# --- AI Coach (необязательно) ---
# Без валидного ключа коуч работает на локальных правилах, приложение не падает.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# Запасной провайдер, используется если Gemini не ответил
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Источники данных Dota 2 ---
# Токен STRATZ: https://stratz.com/api . Без него всё работает через OpenDota,
# но в карточках матчей не будет предметов.
STRATZ_API_TOKEN=
STRATZ_GQL_API=https://api.stratz.com/graphql

# Ключ Steam Web API, нужен только для поиска по vanity-ссылке профиля.
# STEAM_API_KEY=

# --- Сессии ---
# Обязательно смените на свою случайную строку:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
